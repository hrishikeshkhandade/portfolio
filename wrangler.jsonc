// Cloudflare deployment: static site from ./dist plus one small function for the Chef's Fridge demo.
// Before first deploy: create the KV namespace and paste its id below, and set the secret:
//   npx wrangler kv namespace create LIMITS
//   npx wrangler secret put GEMINI_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "LIMITS", "id": "7dc6474d71734e73a56549cb3c374c1b" }],
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite", "DAILY_PER_VISITOR": "3", "DAILY_TOTAL": "120" }
}
